# Copy to .env and fill in the two workspace keys.
# Each key belongs to one user and carries its own spend ceiling in Otari.

# One workspace API key per user. Prefix is otk_v1_us_
PURSE_KEY_ALICE=
PURSE_KEY_BOB=

# Bond each user starts with, in dollars. Keep it small so the meter is visible.
PURSE_BOND_ALICE=0.01
PURSE_BOND_BOB=0.001

# Open-weight models. Both must be real ids from GET /api/v1/models.
PURSE_LOOP_MODEL=alibaba/qwen3.6-35b-a3b
PURSE_SETTLE_MODEL=alibaba/qwen3.6-35b-a3b

# Comma separated ids from Tools -> MCP servers in the Otari dashboard.
PURSE_MCP_SERVER_IDS=

# Reserve required before each call, in dollars.
PURSE_CALL_RESERVE_USD=0.0005

# Set to 1 to simulate every model call for local UI work.
PURSE_MOCK=0

PORT=3000
