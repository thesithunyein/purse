# Copy to .env and fill in the two workspace keys.
# Each key belongs to one user and carries its own spend ceiling in Otari.

# One workspace API key per user. Prefix is otk_v1_us_
PURSE_KEY_ALICE=
PURSE_KEY_BOB=

# Bond each user starts with, in dollars. Keep it small so the meter is visible.
# Set a bond above a key's own Otari budget when you want that cap to bind first.
PURSE_BOND_ALICE=0.20
PURSE_BOND_BOB=0.10

# Open-weight models. Both must be real ids from GET /api/v1/models, and they
# must differ: the small one runs the loop, the large one settles.
PURSE_LOOP_MODEL=alibaba/qwen3-30b-a3b-instruct-2507
PURSE_SETTLE_MODEL=alibaba/qwen3-next-80b-a3b-instruct

# Inline MCP server, connected on the request itself so nothing has to be
# registered in the dashboard. Leave the url empty to skip the policy stage.
# GitMCP serves any public repo as a streamable HTTP MCP endpoint.
PURSE_MCP_NAME=rulebook
PURSE_MCP_URL=
PURSE_MCP_HINT=Use for the spending policy this agent must follow

# Worst case each stage must be able to cover before it starts. A live code
# execution call bills around 0.02, a plain chat call under 0.001.
PURSE_RESERVE_PLAIN_USD=0.001
PURSE_RESERVE_TOOL_USD=0.03

# Otari guardrail run on every stage's input in block mode. A flagged call is
# refused by Otari before any provider runs, and Purse slashes the bond.
# Configure and mandate the profile first: Organization -> Guardrails.
# Leave empty to turn it off. on_unavailable=monitor serves a call Otari could
# not check (logged as unavailable); block refuses it with a 502.
PURSE_GUARDRAIL_PROFILE=
PURSE_GUARDRAIL_ON_UNAVAILABLE=monitor

# Service-key mode (optional). One Otari service key instead of the two keys
# above; each bond holder becomes an Otari end user (purse:alice, purse:bob)
# with a budget Otari enforces. The budget ids must be on the key's list.
PURSE_SERVICE_KEY=
PURSE_END_USER_BUDGET_ALICE=
PURSE_END_USER_BUDGET_BOB=

# Shared code for a public deploy. Every /api route needs it when set.
PURSE_ACCESS_CODE=

# Set to 1 to simulate every model call for local UI work.
PURSE_MOCK=0

PORT=3000
